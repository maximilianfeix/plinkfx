{
  "name": "plinkfx",
  "version": "0.2.0",
  "description": "Game sound effects as code: 184 CC0 SFX (coin, jump, laser, UI clicks, loops) and a 3.1 kB Web Audio player. CLI for WAV/OGG, no audio files.",
  "keywords": [
    "sound-effects",
    "sfx",
    "sound",
    "audio",
    "game-audio",
    "gamedev",
    "game",
    "webaudio",
    "web-audio",
    "ui-sounds",
    "procedural-audio",
    "synth",
    "sfxr",
    "jsfxr",
    "zzfx",
    "audio-sprite",
    "cc0",
    "typescript"
  ],
  "homepage": "https://maximilianfeix.github.io/plinkfx/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/plinkfx.git"
  },
  "bugs": {
    "url": "https://github.com/maximilianfeix/plinkfx/issues"
  },
  "license": "(MIT AND CC0-1.0)",
  "author": {
    "name": "Maxi",
    "url": "https://github.com/maximilianfeix"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./sounds": {
      "types": "./dist/sounds.d.ts",
      "default": "./dist/sounds.js"
    },
    "./meter": {
      "types": "./dist/meter.d.ts",
      "default": "./dist/meter.js"
    },
    "./package.json": "./package.json",
    "./catalog.json": "./dist/catalog.json"
  },
  "bin": {
    "plinkfx": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-SOUNDS"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bake": "node scripts/bake.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "size": "size-limit",
    "gallery:dev": "vite --config vite.config.ts",
    "gallery:build": "vite build --config vite.config.ts",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "size-limit": [
    {
      "name": "player: render + play + wav",
      "path": "dist/core.js",
      "import": "{ play, render, wav }",
      "limit": "3.1 kB",
      "gzip": true
    },
    {
      "name": "player + one sound (tree-shaken)",
      "import": {
        "dist/core.js": "{ play }",
        "dist/sounds.js": "{ coin }"
      },
      "limit": "3.1 kB",
      "gzip": true
    },
    {
      "name": "everything: all sounds, play by name",
      "path": "dist/index.js",
      "import": "*",
      "limit": "16 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "size-limit": "^14.3.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ],
      "sounds": [
        "dist/sounds.d.ts"
      ],
      "meter": [
        "dist/meter.d.ts"
      ]
    }
  }
}
